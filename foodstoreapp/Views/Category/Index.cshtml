@model IEnumerable<foodstoreapp.Models.category>
<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Категории</h2>
        </div>
        <div class="col-6 text-right">
            <a asp-controller="category" asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> &nbsp; Создать

            </a>
        </div>
    </div>
</div>
    <br /><br />
@if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped" style="width:100%">
            <thead>
                <tr>
                    <th>
                        Название
                    </th>
                    <th>
                        Описание
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td width="50%">@category.Title</td>
                        <td width="30%">@category.Description</td>
                        <td class="text-center">
                            <div class="w-75 btn-group" role="group">
                                <div class="w-75 bin-group" role="group">
                                    <a asp-controller="category" asp-route-Id="@category.Id" asp-
                                       action="Edit" class="btn btn-primary mx-2">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="category" asp-route-Id="@category.Id" asp-
                                       action="Delete" class="btn btn-danger mx-2">
                                        <i class="far fa-trash-alt"></i>
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>  Нет действующих категорий</p>
    }
    <div>
    </div>
